{
  "name": "nedarim",
  "version": "0.3.0",
  "description": "מערכת ניהול נדרים, תרומות והוצאות לבית כנסת – יישום Windows עצמאי (Offline)",
  "license": "GPL-3.0-or-later",
  "private": false,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:clean": "npm ci --ignore-scripts && node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run check && npm run test && electron-vite build && electron-builder --win --x64",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "vite-node --config vitest.config.ts tools/import/cli.ts --",
    "icon": "node tools/icon/make-icon.mjs",
    "proof:restore": "vite-node --config vitest.config.ts tools/proof/restore-proof.ts --",
    "proof:backfill": "vite-node --config vitest.config.ts tools/proof/backfill-report.ts --",
    "proof:notify": "vite-node --config vitest.config.ts tools/proof/notify-sample.ts --",
    "proof:occasions": "vite-node --config vitest.config.ts tools/proof/occasion-keys.ts --",
    "licenses": "vite-node --config vitest.config.ts tools/licenses/collect.ts",
    "release:notes": "vite-node --config vitest.config.ts tools/release/write-notes.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/assistant": "^5.3.0",
    "@hebcal/core": "^5.10.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1",
    "write-excel-file": "^4.1.1"
  },
  "author": {
    "name": "NEDARIM contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liorgab/nedarim.git"
  },
  "bugs": {
    "url": "https://github.com/liorgab/nedarim/issues"
  },
  "homepage": "https://github.com/liorgab/nedarim"
}
